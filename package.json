{
  "name": "shakespeare-on-the-sound",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-site-chrome.js && node scripts/use-dev-assets.js && vite",
    "build": "node scripts/ensure-site-chrome.js && node scripts/seed-ticketing.mjs && node scripts/seed-shop.mjs && node scripts/generate-profile-images.mjs && vite build && node scripts/generate-seo.mjs",
    "build:static": "npm run build && node scripts/patch-html.js",
    "sync:sots": "node scripts/sync-sots-content.mjs",
    "sync:ticketing": "node scripts/seed-ticketing.mjs",
    "setup:eventbrite": "node scripts/setup-eventbrite.mjs",
    "deploy": "node scripts/deploy-to-sots.mjs",
    "deploy:push": "node scripts/push-production.mjs",
    "generate": "node scripts/generate-pages.js && node scripts/generate-sitemap.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "start": "npm run preview:local",
    "preview:local": "npm run build:static && npx --yes serve . -p 3000",
    "preview": "vite preview"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "split-type": "^0.3.4",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
