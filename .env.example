# —— Square ticketing (server-side only) ——
# Developer Dashboard: https://developer.squareup.com/apps
# Use Sandbox credentials while testing; switch to Production when you go live.
# NEVER commit .env or paste tokens in chat.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
# Optional — auto-fetched from /v2/locations if omitted
SQUARE_LOCATION_ID=

# Set true to allow sandbox ticket sales when the catalog season is marked ended
TICKETING_SANDBOX_SALES=true

# —— Resend (order confirmation emails) ——
# https://resend.com/api-keys — verify your sending domain before going live
RESEND_API_KEY=
# e.g. Shakespeare on the Sound <tickets@shakespeareonthesound.org>
RESEND_FROM_EMAIL=
# Optional box-office copy of each order
TICKETING_NOTIFY_EMAIL=contactus@shakespeareonthesound.org

# —— Legacy Eventbrite (optional; no longer used for checkout) ——
EVENTBRITE_API_TOKEN=
EVENTBRITE_ORG_ID=2093560299743
EVENTBRITE_FEATURED_EVENT_ID=1986841853468
EVENTBRITE_WEBHOOK_SECRET=

# Domains (scripts/lib/site-domains.mjs):
#   Production: https://www.shakespeareonthesound.org
#   Preview:    https://ubiquitous-maamoul-8b9b7f.netlify.app
