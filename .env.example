# —— Square ticketing (server-side only) ——
# Developer Dashboard: https://developer.squareup.com/apps
# Official samples: https://github.com/Square-Developers
# Node quickstart: https://github.com/Square-Developers/node-getting-started
# NEVER commit .env or paste tokens in chat.
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
# Optional — auto-fetched from /v2/locations if omitted (see node-getting-started pattern)
SQUARE_LOCATION_ID=
# Webhook signature key from Square Dashboard → Webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=

# false in production — only true for sandbox QA when catalog dates are in the past
TICKETING_SANDBOX_SALES=false

# Add TEST performances when no real dates are on sale (auto during build).
# Set false to hide test dates even when the season has ended.
TICKETING_TEST_MODE=

# Public URL Square uses to fetch product photos (preview or production)
SITE_URL=https://ubiquitous-maamoul-8b9b7f.netlify.app

# —— Resend (order confirmation emails + My Tickets magic links + contact form) ——
# https://resend.com/api-keys — verify your sending domain before going live
RESEND_API_KEY=
# Ticket / magic-link sender, e.g. Shakespeare on the Sound <tickets@shakespeareonthesound.org>
RESEND_FROM_EMAIL=
# Contact-form notifications (optional). Defaults to notifications@… if unset.
# e.g. Shakespeare on the Sound Notifications <notifications@shakespeareonthesound.org>
RESEND_NOTIFICATIONS_FROM_EMAIL=
# Optional box-office copy of each order
TICKETING_NOTIFY_EMAIL=contactus@shakespeareonthesound.org
# Contact-form messages are emailed to the clicked staff address
# (contactus / stephanie / nick / aaron / marketing @shakespeareonthesound.org)

# —— Patron My Tickets (email magic-link sign-in) ——
# Required for /my-tickets/ — HMAC secret used to sign magic links + sessions.
# Generate: openssl rand -hex 32
# Also set this in Netlify → Site settings → Environment variables (all contexts).
# Falls back to ADMIN_SECRET / ADMIN_PASSWORD if unset (not recommended).
PATRON_AUTH_SECRET=

# —— Ticketing admin (/admin/ticketing/) ——
ADMIN_PASSWORD=
# Optional; preferred over ADMIN_PASSWORD for signed admin tokens
ADMIN_SECRET=

# —— Legacy Eventbrite (optional; no longer used for checkout) ——
EVENTBRITE_API_TOKEN=
EVENTBRITE_ORG_ID=2093560299743
EVENTBRITE_FEATURED_EVENT_ID=1986841853468
EVENTBRITE_WEBHOOK_SECRET=

# Domains (scripts/lib/site-domains.mjs):
#   Production: https://www.shakespeareonthesound.org
#   Preview:    https://ubiquitous-maamoul-8b9b7f.netlify.app

# —— Constant Contact (homepage newsletter → contact list) ——
# App: https://app.constantcontact.com/pages/dma/portal/
# Auth helper: node scripts/constant-contact-oauth.mjs
# List helper: node scripts/constant-contact-lists.mjs
# Endpoint used: POST /contacts/sign_up_form (explicit opt-in)
# Optional: build a SEGMENT in CC that targets the list for campaigns
CONSTANT_CONTACT_API_KEY=
CONSTANT_CONTACT_CLIENT_SECRET=
# Must match the Redirect URI registered on the app exactly
CONSTANT_CONTACT_REDIRECT_URI=http://localhost:8888/
CONSTANT_CONTACT_REFRESH_TOKEN=
CONSTANT_CONTACT_LIST_ID=
# Seeded by oauth script; Netlify function refreshes + stores rotated tokens in Blobs
CONSTANT_CONTACT_ACCESS_TOKEN=
