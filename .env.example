# Eventbrite private token (OAuth token) — server-side only.
# Create at https://www.eventbrite.com/platform/api-keys/
#   1. Log in → Get a Free API Key (creates an app)
#   2. Open your app → copy "Private token" / "Your OAuth Token"
#   3. Paste here locally; set EVENTBRITE_API_TOKEN in Netlify env vars for production
# Never commit .env. Never expose this token in client-side code or VITE_* vars.
# Rotate/delete unused keys at the same page if a token is ever shared publicly.
EVENTBRITE_API_TOKEN=

# Shakespeare on the Sound organization (optional override)
EVENTBRITE_ORG_ID=2093560299743

# Main-stage series / listing page used for site-wide ticket links
EVENTBRITE_FEATURED_EVENT_ID=1986841853468

# Webhook secret — generated by: npm run setup:eventbrite
# Also set EVENTBRITE_WEBHOOK_SECRET in Netlify (all deploy contexts).
EVENTBRITE_WEBHOOK_SECRET=

# Domains (configured in scripts/lib/site-domains.mjs):
#   Production: https://www.shakespeareonthesound.org
#   Preview:    https://ubiquitous-maamoul-8b9b7f.netlify.app
